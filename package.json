{
  "name": "oneresi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "db:generate": "pnpm --filter @oneresi/db generate",
    "db:migrate": "pnpm --filter @oneresi/db migrate",
    "db:seed": "pnpm --filter @oneresi/db seed",
    "db:reset": "pnpm --filter @oneresi/db reset",
    "db:checksum": "pnpm --filter @oneresi/db checksum",
    "db:studio": "pnpm --filter @oneresi/db studio",
    "typecheck": "tsc --build --verbose",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:copy": "node scripts/check-copy.mjs",
    "check:enums": "node scripts/check-enums.mjs",
    "check:gates": "node scripts/check-copy.mjs --self-test && node scripts/check-enums.mjs --self-test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:parity": "node scripts/run-parity.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm check:copy && pnpm check:enums && pnpm test:parity"
  },
  "devDependencies": {
    "@eslint/js": "9.24.0",
    "@oneresi/contracts": "workspace:*",
    "@oneresi/db": "workspace:*",
    "@types/node": "22.14.0",
    "eslint": "9.24.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-react": "7.37.5",
    "globals": "16.0.0",
    "prettier": "3.5.3",
    "tsx": "4.19.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.29.1",
    "vitest": "3.1.1"
  }
}
