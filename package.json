{
  "name": "grihaone",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "db:generate": "pnpm --filter @grihaone/db generate",
    "db:migrate": "pnpm --filter @grihaone/db migrate",
    "db:seed": "pnpm --filter @grihaone/db seed",
    "db:reset": "pnpm --filter @grihaone/db reset",
    "db:checksum": "pnpm --filter @grihaone/db checksum",
    "db:studio": "pnpm --filter @grihaone/db studio",
    "db:pull": "node scripts/db-pull.mjs",
    "db:push": "node scripts/db-push.mjs",
    "db:diff": "node scripts/db-diff.mjs",
    "push:keys": "node scripts/generate-vapid-keys.mjs",
    "cloud:up": "node scripts/cloud.mjs up",
    "cloud:down": "node scripts/cloud.mjs down",
    "cloud:stop": "node scripts/cloud.mjs stop",
    "cloud:start": "node scripts/cloud.mjs start",
    "cloud:env": "node scripts/cloud.mjs env",
    "typecheck": "tsc -p test && tsc --build --verbose",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:copy": "node scripts/check-copy.mjs",
    "check:enums": "node scripts/check-enums.mjs",
    "check:gates": "node scripts/check-copy.mjs --self-test && node scripts/check-enums.mjs --self-test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e-local.mjs",
    "test:mail:live": "tsx scripts/mail-live.mjs",
    "test:parity": "node scripts/run-parity.mjs",
    "lambdas:build": "node scripts/build-lambdas.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm check:copy && pnpm check:enums && pnpm test:parity"
  },
  "devDependencies": {
    "@eslint/js": "9.24.0",
    "@grihaone/contracts": "workspace:*",
    "@grihaone/db": "workspace:*",
    "@types/node": "22.14.0",
    "eslint": "9.24.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-react": "7.37.5",
    "globals": "16.0.0",
    "prettier": "3.5.3",
    "tsx": "4.19.3",
    "esbuild": "0.25.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.29.1",
    "vitest": "3.1.1"
  }
}
